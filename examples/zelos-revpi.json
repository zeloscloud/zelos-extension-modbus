{
  "name": "zelos-revpi",
  "description": "CODESYS ModbusTCP Server Device on zelos-revpi: PLC_PRG.mb_hold (holding) / PLC_PRG.mb_in (input)",
  "device": {
    "address_base": 0
  },
  "events": {
    "plc": [
      {
        "name": "cycle_count",
        "type": "input",
        "address": 0,
        "datatype": "uint32",
        "byte_order": "big_swap",
        "description": "mb_in[0]=low word, mb_in[1]=high word"
      },
      {
        "name": "sine_value",
        "type": "input",
        "address": 2,
        "datatype": "int16",
        "scale": 0.01
      },
      {
        "name": "heartbeat",
        "type": "input",
        "address": 3,
        "datatype": "uint16"
      },
      {
        "name": "input_state",
        "type": "input",
        "address": 4,
        "datatype": "uint16",
        "description": "pdu TPDO1 inputs via CODESYS CANopen"
      },
      {
        "name": "relay_cmd",
        "type": "input",
        "address": 5,
        "datatype": "uint16",
        "description": "PLC relay command (RPDO1)"
      },
      {
        "name": "engine_rpm",
        "type": "input",
        "address": 6,
        "datatype": "uint16",
        "unit": "rpm",
        "description": "J1939 SPN 190 via CODESYS"
      },
      {
        "name": "engine_coolant_c",
        "type": "input",
        "address": 7,
        "datatype": "int16",
        "unit": "degC",
        "description": "J1939 SPN 110 via CODESYS"
      },
      {
        "name": "vcu_mode",
        "type": "input",
        "address": 8,
        "datatype": "uint16",
        "values": {
          "0": "Standby",
          "1": "Drive",
          "2": "Charge",
          "3": "Fault"
        }
      },
      {
        "name": "vcu_tx_count",
        "type": "input",
        "address": 9,
        "datatype": "uint16"
      }
    ],
    "setpoints": [
      {
        "name": "setpoint",
        "type": "holding",
        "address": 0,
        "datatype": "uint16",
        "scale": 0.1,
        "writable": true,
        "description": "x10; PLC applies when non-zero"
      },
      {
        "name": "vcu_mode_override",
        "type": "holding",
        "address": 1,
        "datatype": "uint16",
        "writable": true,
        "values": {
          "0": "Auto",
          "1": "Standby",
          "2": "Drive",
          "3": "Charge",
          "4": "Fault"
        },
        "description": "0 = PLC auto cycle; else mode+1"
      },
      {
        "name": "bench_quiet",
        "type": "holding",
        "address": 2,
        "datatype": "uint16",
        "writable": true,
        "values": {
          "0": "Live",
          "1": "Quiet"
        },
        "description": "1 = PLC stops VCU TX and relay walk; default 0"
      }
    ]
  }
}
