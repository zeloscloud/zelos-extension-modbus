{
  "name": "codesys_modbus_tcp_server",
  "description": "CODESYS ModbusTCP Server Device (port 502, unit 1): Input Registers[0..9] <- PLC_PRG.mb_in, Holding Registers[0..9] <- PLC_PRG.mb_hold. Wire addresses (address_base 0). The PLC packs the arrays in ST.",
  "device": {
    "address_base": 0
  },
  "events": {
    "plc": [
      {
        "name": "cycle_count",
        "type": "input",
        "address": 0,
        "datatype": "uint32",
        "byte_order": "big_swap",
        "description": "mb_in[0]=low word, mb_in[1]=high word"
      },
      {
        "name": "sine_value",
        "type": "input",
        "address": 2,
        "datatype": "int16",
        "scale": 0.01,
        "description": "Test sine x100"
      },
      {
        "name": "heartbeat",
        "type": "input",
        "address": 3,
        "datatype": "uint16",
        "description": "Toggles every PLC cycle"
      },
      {
        "name": "input_state",
        "type": "input",
        "address": 4,
        "datatype": "uint16",
        "description": "Digital inputs of a CANopen node (TPDO1) read by the PLC's CANopen manager"
      },
      {
        "name": "relay_cmd",
        "type": "input",
        "address": 5,
        "datatype": "uint16",
        "description": "Relay command the PLC sends to the CANopen node (RPDO1)"
      },
      {
        "name": "engine_rpm",
        "type": "input",
        "address": 6,
        "datatype": "uint16",
        "unit": "rpm",
        "description": "J1939 EngineSpeed (SPN 190) decoded by the PLC's J1939 manager"
      },
      {
        "name": "engine_coolant_c",
        "type": "input",
        "address": 7,
        "datatype": "int16",
        "unit": "degC",
        "description": "J1939 EngineCoolantTemp (SPN 110) decoded by the PLC's J1939 manager"
      },
      {
        "name": "vcu_mode",
        "type": "input",
        "address": 8,
        "datatype": "uint16",
        "values": {
          "0": "Standby",
          "1": "Drive",
          "2": "Charge",
          "3": "Fault"
        },
        "description": "Mode the PLC's CAN TX cycle is in"
      },
      {
        "name": "vcu_tx_count",
        "type": "input",
        "address": 9,
        "datatype": "uint16",
        "description": "Frames the PLC has sent on its CAN TX cycle"
      }
    ],
    "setpoints": [
      {
        "name": "setpoint",
        "type": "holding",
        "address": 0,
        "datatype": "uint16",
        "scale": 0.1,
        "writable": true,
        "description": "x10; PLC applies when non-zero"
      },
      {
        "name": "vcu_mode_override",
        "type": "holding",
        "address": 1,
        "datatype": "uint16",
        "writable": true,
        "values": {
          "0": "Auto",
          "1": "Standby",
          "2": "Drive",
          "3": "Charge",
          "4": "Fault"
        },
        "description": "0 = PLC auto cycle; else mode+1"
      },
      {
        "name": "bench_quiet",
        "type": "holding",
        "address": 2,
        "datatype": "uint16",
        "writable": true,
        "values": {
          "0": "Live",
          "1": "Quiet"
        },
        "description": "1 = PLC stops its CAN TX cycle and relay walk; default 0"
      }
    ]
  }
}
